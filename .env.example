# Copy to .env. The .env file is gitignored; this example is not.
#
# Anything prefixed VITE_ is compiled into the client bundle and is readable by
# anyone who opens the page. Nothing secret goes in those, and there is nothing
# secret in this project to put there: the service holds no keys and no funds.

# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------

# Where the oracle and challenge service lives. Leave it empty and the client
# plays practice missions generated from the date, labelled as practice. That
# is a valid reduced build, not a broken one.
# Local service: http://localhost:8790
# Production API: https://api.nim-rush.xyz (frontend: https://www.nim-rush.xyz)
VITE_API_BASE=http://localhost:8790

# ---------------------------------------------------------------------------
# NIM Atlas TestAlbatross payment handoff
# ---------------------------------------------------------------------------
#
# The client and server values must match. The VITE_ values are public review
# fields, never secrets. Keep both enabled flags false until the owner approves
# the exact recipient and deployed mobile test. Never use the committed fixture
# recipient for a live send.
VITE_ATLAS_TESTNET_ENABLED=false
VITE_ATLAS_TESTNET_RECIPIENT=
VITE_ATLAS_TESTNET_PRICE_LUNA=10000

# Goes inside the nimiqpay:// challenge deeplinks. Get this wrong and a shared
# challenge opens the wrong app. Defaults to window.location.origin.
VITE_APP_ORIGIN=http://localhost:5173

# Where an anchored run is sent.
#
# Anchoring writes a score onto the chain as an ordinary Nimiq transaction
# carrying the run in its data field. Every anchor goes to this one address, so
# a single explorer page lists every run ever anchored and every wallet that
# sent one, which is the point: it is one link that proves the whole thing.
#
# Leave it empty and the app never offers to anchor. That is the right default
# for a fork or a local checkout, because nobody should be able to send NIM to
# an address the person running the app did not choose.
#
# It must match ANCHOR_ADDRESS on the service, or every anchor is refused for
# having the wrong recipient.
VITE_ANCHOR_ADDRESS=

# ---------------------------------------------------------------------------
# Service. Not exposed to the client.
# ---------------------------------------------------------------------------

PORT=8790

# The service is payment-authoritative. It independently pins the catalog and
# verifies canonical success, recipient, integer Luna value, and confirmations.
# A provider lookup or transaction hash never fulfills an order by itself.
# Which chain the service settles on. testalbatross (practice) or
# mainalbatross (real NIM). An unrecognised value is refused rather than
# defaulted, because guessing a network is how real money settles on the wrong
# chain. Each network reads only its own variables below; neither ever falls
# back to the other's recipient or RPC list.
ATLAS_NETWORK=testalbatross

ATLAS_TESTNET_ENABLED=false
ATLAS_TESTNET_RECIPIENT=
ATLAS_TESTNET_PRICE_LUNA=10000
ATLAS_TESTNET_RPC_URLS=
ATLAS_TESTNET_MIN_CONFIRMATIONS=3
# Optional on practice networks. See the mainnet note below for what it does.
ATLAS_TESTNET_GENESIS_HASH=

# Mainnet moves real NIM. Nothing here is shared with the testnet block.
ATLAS_MAINNET_ENABLED=false
ATLAS_MAINNET_RECIPIENT=
ATLAS_MAINNET_PRICE_LUNA=10000
ATLAS_MAINNET_RPC_URLS=
ATLAS_MAINNET_MIN_CONFIRMATIONS=3
# REQUIRED for mainalbatross. The service refuses to enable payments without
# it, with reason 'missing-genesis-hash'.
#
# Why: the chain reader used to stamp every observation with the configured
# network name without ever asking the RPC which chain it served, and the order
# guard then compared that label against another copy of the same configured
# string. A mainnet config pointed at a practice RPC therefore passed every
# check while settling real payments on practice evidence.
#
# The reader now fetches block 0 (getBlockByNumber [0, false]) once and refuses
# to return any evidence unless its hash matches this value. Get the hash from
# a block explorer or your own node and paste it here; it is intentionally not
# hardcoded in the source, because a genesis hash written from memory is
# exactly the unverified assertion this check exists to catch.
ATLAS_MAINNET_GENESIS_HASH=

# Comma separated. Required when NODE_ENV=production. Development permits every
# origin only when this is empty, and logs that choice at boot.
ALLOWED_ORIGINS=http://localhost:5173

# Set to true when running behind Caddy or any other proxy. Without it the rate
# limiter sees every request as coming from the proxy and buckets the whole
# internet together, so one noisy client locks everyone else out.
TRUST_PROXY=false

# Where the leaderboard, challenge and ghost snapshot is written. Defaults to
# .data in the working directory, which quietly resets the board if each
# release deploys into a fresh directory.
# DATA_DIR=/var/lib/sface
# Relay Season 0 uses one API writer for crash-safe JSON persistence.
RELAY_WRITER_COUNT=1

# Atlas production gates. Durable state must be enabled before competition or
# rewards can become visible. Keep all three false until the full mobile,
# replay, payout, and recovery checks have passed.
ATLAS_DURABLE_REPOSITORY_ENABLED=false
ATLAS_COMPETITIVE_ENABLED=false
ATLAS_REWARDS_ENABLED=false
# Address the reward pool pays out of. Required before any payout route
# exists: with it unset the payout service is not constructed and
# /admin/api/atlas/payouts is not mounted at all.
#
# Release is supervised on purpose. The routes sit behind admin auth and a
# single-use operation nonce, so a person approves, submits and reconciles
# each batch. There is no automatic payout, because the ledger's duplicate-id
# refusal is the only guard against paying one reward twice and it is worth
# checking by hand while it is new.
ATLAS_TREASURY_ADDRESS=
# Required before competitive tickets can be issued. These values are server-pinned into every ticket.
ATLAS_COMPETITIVE_SEASON_ID=
ATLAS_COMPETITIVE_CHALLENGE_ID=
ATLAS_COMPETITIVE_SEED=
ATLAS_COMPETITIVE_CAMPAIGN_HASH=
ATLAS_COMPETITIVE_CURRICULUM_HASH=
ATLAS_COMPETITIVE_RULESET_HASH=

# ---------------------------------------------------------------------------
# Public experience and legacy archive. Keep the former game administrator-only.
# ---------------------------------------------------------------------------

PUBLIC_EXPERIENCE=relay
LEGACY_PUBLIC_ENABLED=false
LEGACY_WRITES_ENABLED=false
LEGACY_ADMIN_READS_ENABLED=true

# ---------------------------------------------------------------------------
# NIM Rescue Relay. Practice remains available when competitive configuration
# is incomplete. Rewards never become enabled without an explicit treasury and
# RPC configuration.
# ---------------------------------------------------------------------------

RELAY_ENABLED=false
RELAY_COMPETITIVE_ENABLED=false
RELAY_REWARDS_ENABLED=false
RELAY_SEASON_ID=season-0
RELAY_TREASURY_ADDRESS=
RELAY_MIN_CONFIRMATIONS=10
RELAY_NIMIQ_NETWORK=test
RELAY_SEASON_ALLOCATION_LUNA=8000000000
NIMIQ_RPC_URLS=

# ---------------------------------------------------------------------------
# Crypto X sentiment, via Grok. Optional.
# ---------------------------------------------------------------------------
#
# With this set, the daily mission carries a real headline, a sentiment read
# off the timeline, and a roster of five accounts who were actually being
# discussed today. Without it the mission falls back to the fictional
# archetypes and says nothing it cannot back up.
#
# Called once per UTC day with a hard ceiling of 8 calls per day and
# exponential backoff, so a runaway loop cannot run up a bill. Get a key at
# console.x.ai.
# XAI_API_KEY=xai-...

# Override only if you know a newer model supports the x_search tool.
# XAI_MODEL=grok-4.5

# ---------------------------------------------------------------------------
# Connect X, so a player's own picture rides on their character. Optional.
# ---------------------------------------------------------------------------
#
# OAuth 2.0 with PKCE, from developer.x.com. The secret stays on the service:
# the exchange happens server side because a secret in a Vite bundle is not a
# secret. Nothing about the account is stored, not even a refresh token.
#
# X_REDIRECT_URI must match the callback registered on the X app exactly,
# and it points at THIS service, not at the client.
# X_CLIENT_ID=...
# X_CLIENT_SECRET=...
# X_REDIRECT_URI=http://localhost:8790/x/callback

# ---------------------------------------------------------------------------
# Real profile pictures for the people in today's wreck. Optional.
# ---------------------------------------------------------------------------
#
# With this set, the five accounts crypto X was actually arguing about today
# appear in the wreck with their real profile pictures instead of generated
# figures. Without it they are generated figures and nothing else changes.
#
# This is app-only auth and needs a DIFFERENT credential from the OAuth pair
# above. The developer portal shows a ready-made Bearer Token under Keys and
# tokens; copy that. Passing X_CLIENT_ID here returns a 403 that does not
# explain itself.
# X_BEARER_TOKEN=...
#
# The same token powers CT Signals, which reads the public replies and
# mentions on a player's handle so they can see which of the people who
# actually talk to them already fly here. Public data only, computed on the
# fly, never stored.
#
# Or, if you would rather mint the token yourself, the consumer pair works:
# X_API_KEY=...
# X_API_SECRET=...

# ---------------------------------------------------------------------------
# CT Signals pricing. Optional.
# ---------------------------------------------------------------------------
#
# Where a deep read is paid to, and what it costs. LEAVE THE TREASURY UNSET
# AND THE DEEP READ IS SIMPLY FREE, which is the right default: a paywall with
# nowhere to pay is a dead end, not a business model.
#
# The payment is reported by the client, not verified on chain, exactly like
# challenge settlement and for the same reason. That is a documented gap. It
# matters less here than it looks: this repo is MIT and public, so the deep
# read was never behind a lock anybody had to break. The money keeps the X API
# credit topped up and the screen says so.
# SFACE_TREASURY=NQ...
# SIGNALS_PRICE_NIM=2

# ---------------------------------------------------------------------------
# Anchoring, on the service
# ---------------------------------------------------------------------------

# The same address as VITE_ANCHOR_ADDRESS above. The service checks that every
# anchored transaction was actually sent here before it records one; without it
# anybody could send themselves a transaction saying anything and present it as
# proof. Empty turns anchoring off and the route says so plainly.
ANCHOR_ADDRESS=

# Which chain counts as real.
#
# A transaction verifies perfectly well against its own network id, so without
# this a testnet anchor, which costs nothing, would sit on the board looking
# exactly like one that cost real NIM. The numeric ids are not in the library type
# definitions, so this is configured rather than guessed: 5 is what a mainnet
# transaction carries in the version pinned here. If it is wrong every anchor is
# refused and the log line names the id that actually arrived.
ANCHOR_NETWORK_ID=5
# ---------------------------------------------------------------------------
# Admin control plane. Service only, never expose these to Vite.
# ---------------------------------------------------------------------------

# Required before /admin/api routes can be used. The browser keeps it in memory
# only and asks again after every refresh.
ADMIN_TOKEN=

# Optional comma-separated client IP allowlist, evaluated after trusted proxy
# resolution. Empty permits any IP that presents the correct token.
ADMIN_ALLOWED_IPS=

# Enables the nonce-protected restart button. Use only when a supervisor such as
# systemd, Docker, or Render will restart the process after graceful SIGTERM.
ADMIN_RESTART_ENABLED=false

# Deployment identifier shown in diagnostics. It is not secret.
GIT_COMMIT=
