{
  "name": "nim-rush",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run verify:atlas:art && npm run verify:atlas:3d",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "server": "tsx --env-file-if-exists=.env server/start.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env server/start.ts",
    "prove": "tsx scripts/prove.ts",
    "prove:blitz": "tsx scripts/prove-blitz.ts",
    "archive:legacy:dry": "tsx --env-file-if-exists=.env scripts/archive-legacy.ts",
    "prove:relay": "tsx --env-file-if-exists=.env scripts/prove-relay.ts",
    "restore:backup": "tsx --env-file-if-exists=.env scripts/restore-backup.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "icons": "node scripts/make-icons.mjs",
    "brand": "node scripts/make-brand.mjs",
    "shoot:atlas": "node scripts/shoot-atlas.mjs",
    "build:atlas:3d": "node scripts/build-atlas-3d.mjs",
    "audio:atlas": "node scripts/generate-atlas-audio.mjs",
    "measure:atlas": "node scripts/measure-atlas.mjs",
    "verify:atlas:art": "node scripts/verify-atlas-assets.mjs",
    "verify:atlas:3d": "node scripts/verify-atlas-3d.mjs",
    "verify:atlas:contrast": "node scripts/verify-atlas-contrast.mjs",
    "format:check": "node scripts/check-format.mjs",
    "build:atlas:character:v2": "node scripts/build-atlas-character-v2.mjs",
    "brand:render": "node scripts/render-brand.mjs"
  },
  "//": "express, zod and tsx are runtime dependencies of the service, not build tools. They were in devDependencies, which meant an npm ci --omit=dev on the VPS produced a server that could not start. The SDK is pinned rather than tracking latest, because its published surface is what src/nimiq is written against.",
  "dependencies": {
    "@nimiq/core": "2.7.2",
    "@nimiq/mini-app-sdk": "0.1.0",
    "express": "4.22.2",
    "pixi.js": "8.20.0",
    "qrcode-generator": "2.0.4",
    "three": "0.185.1",
    "tsx": "4.23.1",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "26.1.2",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
